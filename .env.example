# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Local PostgreSQL. For RDS, see docs/MIGRATION.md (step 3).
DATABASE_URL=postgresql://tactum_app:change-me@localhost:5432/tactum
DATABASE_SSL=disable
# On RDS: DATABASE_SSL=verify-full and the path to the AWS CA bundle.
# DATABASE_SSL_ROOT_CERT=/etc/ssl/rds/global-bundle.pem

# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Whole MXN. The deposit is what the customer is charged now.
PRODUCT_TOTAL_PRICE_MXN=875
DEPOSIT_AMOUNT_MXN=300
